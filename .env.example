# ==============================================================
# Quanteinstein B2B Outbound Intelligence Engine Configuration
# ==============================================================

# LLM Provider: 'gemini', 'openai', or 'heuristic' (offline rule-based engine)
LLM_PROVIDER=heuristic

# API Keys (optional if LLM_PROVIDER=heuristic)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model Names
GEMINI_MODEL=gemini-2.5-flash
OPENAI_MODEL=gpt-4o-mini

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Message Generation Constraints
MAX_MESSAGE_WORDS=45
MIN_INTENT_SCORE_FOR_OUTREACH=8

# ==============================================================
# Local Email (Gmail / Outlook) Configuration
# ==============================================================
# Your Email ID (e.g. your_name@gmail.com)
SMTP_USER=
# For Gmail: Use a 16-character Google App Password from: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=
# SMTP Host: 'smtp.gmail.com' for Gmail, 'smtp.office365.com' for Outlook
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Your Name / Title for Email Signature
SENDER_NAME=Onkar (Founder, Quanteinstein)

